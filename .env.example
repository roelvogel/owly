# xAI API key from https://console.x.ai
XAI_API_KEY=

# Model name
XAI_MODEL=grok-4.5
XAI_BASE_URL=https://api.x.ai/v1

# Paths (relative to project root)
OUTPUT_DIR=editions
DATA_DIR=data

# Grok output limits
MAX_OUTPUT_TOKENS=4096

# How far back to look for RSS items and X search (hours)
INGESTION_HOURS=12

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8741

# Optional: shared secret for /api/* (remote clients over VPN)
OWLY_API_KEY=
