# xAI API key from https://console.x.ai
XAI_API_KEY=

# Model name
XAI_MODEL=grok-4.6
XAI_BASE_URL=https://api.x.ai/v1

# Paths (relative to project root)
OUTPUT_DIR=editions
DATA_DIR=data

# Grok output limits (search-only collect calls)
MAX_OUTPUT_TOKENS=4096
MAX_MAIN_OUTPUT_TOKENS=16384
XAI_SEARCH_MAX_TOKENS=2500

# How far back to look for RSS items and X search (hours)
INGESTION_HOURS=12

# Parallel stock digest calls (per ticker)
STOCK_MAX_WORKERS=3

# Cursor agent — writes and curates editions (same usage pool as the IDE)
# Key: https://cursor.com/dashboard/api
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
CURSOR_TIMEOUT_SECONDS=600

# Dashboard listen address. 0.0.0.0 is required for Tailscale / LAN tablet access.
# Use 127.0.0.1 for local-only.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8741

# Optional: shared secret for /api/* (remote clients over VPN)
OWLY_API_KEY=
